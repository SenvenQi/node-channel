{
  "name": "@sevenqi/nodechannel",
  "version": "1.1.6",
  "description": "nodejs channel",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "tsc",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"{lib,test}/**/*.ts\" index.ts",
    "format:check": "prettier --check \"{lib,test}/**/*.ts\" index.ts",
    "start": "tsc && node ./dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SenvenQi/node-channel.git"
  },
  "keywords": [
    "channel",
    "socket",
    "udp",
    "webSocket",
    "hid",
    "serialport"
  ],
  "author": "SevenQi",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/SenvenQi/node-channel/issues"
  },
  "homepage": "https://github.com/SenvenQi/node-channel#readme",
  "devDependencies": {
    "@types/node": "^18.11.9",
    "@types/node-hid": "^1.3.1",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.2.5",
    "typescript": "^4.8.4"
  },
  "files": [
    "dist/**",
    "README.md",
    "package.json"
  ],
  "dependencies": {
    "@types/ws": "^8.5.3",
    "node-hid": "^2.1.2",
    "serialport": "^10.5.0",
    "uuid": "^9.0.0",
    "ws": "^8.11.0"
  }
}
